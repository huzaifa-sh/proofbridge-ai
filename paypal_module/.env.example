# PayPal Sandbox Credentials (Replace with your actual Sandbox values in .env)
# Do NOT commit your real .env file to version control.
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: Frontend redirect URLs for PayPal buyer approval and cancellation
FRONTEND_RETURN_URL=https://example.com/checkout/return
FRONTEND_CANCEL_URL=https://example.com/checkout/cancel
